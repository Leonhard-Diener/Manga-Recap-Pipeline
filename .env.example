# Copy this file to .env and insert the keys for the services you use.
OPENROUTER_API_KEY=sk-or-v1-...
# Change only this line to switch models. A full OpenRouter model link also works.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Native Google AI Studio description runner (test_description_google.py).
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GOOGLE_MODEL=gemini-3.5-flash-lite
# high=1120 image tokens and is recommended for manga OCR; medium=560, low=280.
GOOGLE_MEDIA_RESOLUTION=high
